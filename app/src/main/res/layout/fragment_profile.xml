<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile tab. From top to bottom: a header card with the user's initials avatar, name,
    "title · class · school" line and "about me" text (the pencil opens an edit dialog);
    a small quote card; option groups (General, Data, About) as cards with section headings;
    a highlighted "support the developer" card and the app version.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".presentation.profile.ProfileFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="@string/profile" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/app_bar_layout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <!-- PROFILE HEADER -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcv_profile_header"
                    style="@style/ProfileSectionCard"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <!-- Avatar: initials of the name, or a person icon when no name is set. -->
                        <FrameLayout
                            android:id="@+id/fl_avatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_profile_avatar"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tv_avatar_initials"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                android:textColor="?attr/colorOnPrimary"
                                tools:text="SA" />

                            <ImageView
                                android:id="@+id/iv_avatar_placeholder"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/baseline_person_24"
                                android:visibility="gone"
                                app:tint="?attr/colorOnPrimary" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_full_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            app:layout_constraintBottom_toTopOf="@+id/tv_profile_subtitle"
                            app:layout_constraintEnd_toStartOf="@+id/btn_edit_user"
                            app:layout_constraintStart_toEndOf="@+id/fl_avatar"
                            app:layout_constraintTop_toTopOf="@+id/fl_avatar"
                            app:layout_constraintVertical_chainStyle="packed"
                            tools:text="Sabahattin" />

                        <TextView
                            android:id="@+id/tv_profile_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:alpha="0.8"
                            app:layout_constraintBottom_toBottomOf="@+id/fl_avatar"
                            app:layout_constraintEnd_toEndOf="@+id/tv_full_name"
                            app:layout_constraintStart_toStartOf="@+id/tv_full_name"
                            app:layout_constraintTop_toBottomOf="@+id/tv_full_name"
                            tools:text="Student · 3rd year · Ankara University" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_user"
                            style="?attr/materialIconButtonFilledTonalStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/edit_profile"
                            app:icon="@drawable/baseline_edit_24"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_about_me"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:visibility="gone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/barrier_header"
                            tools:text="About me text"
                            tools:visibility="visible" />

                        <androidx.constraintlayout.widget.Barrier
                            android:id="@+id/barrier_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:barrierDirection="bottom"
                            app:constraint_referenced_ids="fl_avatar,tv_profile_subtitle" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- QUOTE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="28dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_ataturk_quotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="italic"
                        tools:text="&quot;Hayattaki en hakiki mürşit ilimdir, fendir.&quot;" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="— Mustafa Kemal Atatürk"
                        android:textAlignment="textEnd"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <!-- GENERAL -->
                <TextView
                    style="@style/ProfileSectionHeader"
                    android:text="@string/profile_section_general" />

                <com.google.android.material.card.MaterialCardView style="@style/ProfileSectionCard">
                    <TextView
                        android:id="@+id/tv_settings"
                        style="@style/ProfileOptionRow"
                        android:text="@string/settings"
                        app:drawableStartCompat="@drawable/baseline_settings_24" />
                </com.google.android.material.card.MaterialCardView>

                <!-- DATA -->
                <TextView
                    style="@style/ProfileSectionHeader"
                    android:text="@string/profile_section_data" />

                <com.google.android.material.card.MaterialCardView style="@style/ProfileSectionCard">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_export_data"
                            style="@style/ProfileOptionRow"
                            android:text="@string/export_data"
                            app:drawableStartCompat="@drawable/baseline_file_upload_24" />

                        <com.google.android.material.divider.MaterialDivider style="@style/ProfileRowDivider" />

                        <TextView
                            android:id="@+id/tv_import_data"
                            style="@style/ProfileOptionRow"
                            android:text="@string/import_data"
                            app:drawableStartCompat="@drawable/baseline_file_download_24" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ABOUT -->
                <TextView
                    style="@style/ProfileSectionHeader"
                    android:text="@string/profile_section_about" />

                <com.google.android.material.card.MaterialCardView style="@style/ProfileSectionCard">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_support"
                            style="@style/ProfileOptionRow"
                            android:text="@string/support_contact"
                            app:drawableStartCompat="@drawable/baseline_contact_support_24" />

                        <com.google.android.material.divider.MaterialDivider style="@style/ProfileRowDivider" />

                        <TextView
                            android:id="@+id/tv_privacy_policy"
                            style="@style/ProfileOptionRow"
                            android:text="@string/privacy_policy"
                            app:drawableStartCompat="@drawable/baseline_privacy_tip_24" />

                        <com.google.android.material.divider.MaterialDivider style="@style/ProfileRowDivider" />

                        <TextView
                            android:id="@+id/tv_terms"
                            style="@style/ProfileOptionRow"
                            android:text="@string/terms_of_use"
                            app:drawableStartCompat="@drawable/baseline_gavel_24" />

                        <com.google.android.material.divider.MaterialDivider style="@style/ProfileRowDivider" />

                        <TextView
                            android:id="@+id/tv_about"
                            style="@style/ProfileOptionRow"
                            android:text="@string/about"
                            app:drawableStartCompat="@drawable/baseline_help_outline_24" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- SUPPORT THE DEVELOPER -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/ProfileSectionCard"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="?attr/colorTertiaryContainer">
                    <TextView
                        android:id="@+id/tv_support_project"
                        style="@style/ProfileOptionRow"
                        android:text="@string/support_developer"
                        android:textColor="?attr/colorOnTertiaryContainer"
                        app:drawableStartCompat="@drawable/baseline_volunteer_activism_24"
                        app:drawableTint="?attr/colorOnTertiaryContainer" />
                </com.google.android.material.card.MaterialCardView>

                <!-- APP VERSION -->
                <TextView
                    android:id="@+id/tv_app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="32dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Version 1.1.0" />
            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/fl_loading"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/app_bar_layout">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
